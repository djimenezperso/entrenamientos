{
  "functions": {
    "api/index.py": {
      "includeFiles": "motor/**",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/:ruta*",
      "destination": "/api/index?r=:ruta"
    }
  ],
  "headers": [
    {
      "source": "/motor/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/resumen_plan",
      "schedule": "0 17 * * 0"
    }
  ]
}